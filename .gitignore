# FaithFellows monorepo — root ignore rules for web/ (Laravel) and app/ (Expo).
# web/ keeps its own .gitignore too; these rules make the root safe on their own.

# ===== Web (Laravel) =====
web/vendor/
web/node_modules/
web/.env
web/.env.backup
web/.env.production
web/storage/*.key
web/storage/framework/cache/*
web/storage/framework/sessions/*
web/storage/framework/views/*
web/storage/logs/*
web/public/build/
web/public/hot
web/public/storage
web/bootstrap/cache/*.php

# ===== App (Expo) =====
app/node_modules/
app/.expo/
app/.env
app/.env.local
app/dist/
app/web-build/
app/.expo-shared/
app/ios/
app/android/
app/*.jks
app/*.p8
app/*.p12
app/*.key
app/*.mobileprovision

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== IDE =====
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ===== Logs =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== Env =====
.env
.env.*
!.env.example

# ===== Local tooling =====
.claude/settings.local.json
