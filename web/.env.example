APP_NAME=FaithFellows
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Kampala
APP_URL=http://127.0.0.1:8000

# Root domain used for auto-generated church subdomains: {slug}.FF_ROOT_DOMAIN
# Local: "localhost" (Chrome resolves *.localhost) — Production: faithfellows.app
FF_ROOT_DOMAIN=localhost
FF_DEFAULT_CURRENCY=UGX
FF_PLAN_PRICE=60000
FF_DOMAIN_PRICE=60000
FF_FREE_HOSTING_MONTHS=12
FF_GRACE_DAYS=14
FF_CONTACT_EMAIL=service@kakebe.tech

# Initial super admin created by "php artisan db:seed" (change the password in production!)
SEED_SUPER_ADMIN_EMAIL=admin@faithfellows.app
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!2026

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=faithfellows
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime: "log" locally, "reverb" (or "pusher") in production
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
# Production: "redis"
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=ff_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: "log" locally; production use resend or postmark
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@faithfellows.app"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=
POSTMARK_TOKEN=

# S3-compatible storage (Wasabi / Cloudflare R2) for production media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Payments ───────────────────────────────────────────────
# When true (or credentials are missing) gateways are simulated so the
# full giving flow can be exercised locally without real money.
PAYMENTS_SANDBOX=true

IOTEC_BASE_URL=https://pay.iotec.io/api
IOTEC_AUTH_URL=https://id.iotec.io/connect/token
IOTEC_CLIENT_ID=
IOTEC_CLIENT_SECRET=
IOTEC_WALLET_ID=
IOTEC_WEBHOOK_SECRET=

MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CURRENCY=EUR
MTN_MOMO_WEBHOOK_SECRET=

AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=UG
AIRTEL_CURRENCY=UGX
AIRTEL_WEBHOOK_SECRET=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ── Messaging ──────────────────────────────────────────────
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_WHATSAPP_NUMBER=
SMS_ENABLED=false
WHATSAPP_ENABLED=false
# Approximate price per SMS segment (UGX) for composer cost estimates
SMS_COST_UGX=35
# Shared secret Africa's Talking sends with USSD callbacks (?secret=…)
USSD_SECRET=

# ── In-app Bible ───────────────────────────────────────────
# Default translation: kjv, web, bbe or asv (bible-api.com, free, no key).
BIBLE_DEFAULT_TRANSLATION=kjv
# Optional: API.Bible key + bible ids for Kiswahili / Luganda translations.
API_BIBLE_KEY=
API_BIBLE_SWAHILI_ID=
API_BIBLE_LUGANDA_ID=

# Members can follow at most this many churches at once.
FF_MAX_SUBSCRIPTIONS=3
# Browsers allowed to call /api/* (comma-separated). The mobile app is native and unaffected; use * only in development.
CORS_ALLOWED_ORIGINS=*
# Live quizzes: seconds each question is open, then seconds the answer + leaderboard show before the next one
FF_QUIZ_QUESTION_SECONDS=10
FF_QUIZ_REVEAL_SECONDS=5

# Web push (VAPID) — generate with: php artisan ff:vapid
VAPID_SUBJECT=mailto:service@kakebe.tech
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Push to the phone app goes through Expo (https://expo.dev). The token is optional; set it if you turn on
# "enhanced push security" for your Expo account.
EXPO_ACCESS_TOKEN=

# ── Live streaming ─────────────────────────────────────────
# "cloudflare" (Cloudflare Stream) or "self_hosted" (nginx-rtmp)
STREAMING_PROVIDER=self_hosted
STREAMING_RTMP_URL=rtmp://live.faithfellows.app/live
STREAMING_HLS_BASE_URL=https://live.faithfellows.app/hls
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=

# Reverb (WebSockets) — only needed when BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Error tracking (optional)
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"

# Google sign-in for the app and website. Use the OAuth *web* client ID from Google Cloud → APIs & Services → Credentials.
# Several IDs (e.g. web + iOS) can be given in GOOGLE_CLIENT_IDS, comma-separated. No client secret is needed.
GOOGLE_CLIENT_ID=
# Only for the app's hosted-page sign-in. Keep it secret; never commit it.
GOOGLE_CLIENT_SECRET=
# Optional: set when the public https address differs from APP_URL (e.g. a tunnel while testing on a phone).
GOOGLE_REDIRECT_URI=
