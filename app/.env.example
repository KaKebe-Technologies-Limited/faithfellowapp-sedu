# FaithFellows app — copy to .env and edit. Only EXPO_PUBLIC_* variables reach the app code.
# Use your computer's LAN IP (not localhost), so your phone can reach the Laravel server:
#   Windows: ipconfig  →  IPv4 Address      macOS: ipconfig getifaddr en0      Linux: hostname -I
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_IP:8000/api
EXPO_PUBLIC_APP_ENV=development
