# FaithFellows app — copy to .env and edit. Only EXPO_PUBLIC_* variables reach the app code.
# Use your computer's LAN IP (not localhost), so your phone can reach the Laravel server:
#   Windows: ipconfig  →  IPv4 Address      macOS: ipconfig getifaddr en0      Linux: hostname -I
EXPO_PUBLIC_API_URL=auto
EXPO_PUBLIC_APP_ENV=development
# Where the Google sign-in page lives. Leave unset to use the API's address; while testing on a phone set it to the
# public https address of your tunnel (the same one added to Google Cloud), e.g. https://your-name.ngrok-free.app
EXPO_PUBLIC_GOOGLE_AUTH_URL=
# Show "Continue with Google" on the sign-in screen (needs the server-side Google setup). Off by default.
EXPO_PUBLIC_GOOGLE_SIGNIN=0
