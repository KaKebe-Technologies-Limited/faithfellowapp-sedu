{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://faithfellows.com/api",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_GOOGLE_SIGNIN": "1"
      },
      "channel": "production"
    },
    "local-wifi": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.0.103:8000/api",
        "EXPO_PUBLIC_APP_ENV": "development",
        "ALLOW_CLEARTEXT": "1",
        "EXPO_PUBLIC_GOOGLE_SIGNIN": "1"
      },
      "channel": "local-wifi"
    },
    "production-apk": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://faithfellows.com/api",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_GOOGLE_SIGNIN": "1"
      },
      "channel": "production"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://faithfellows.com/api",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_GOOGLE_SIGNIN": "1"
      },
      "channel": "production"
    },
    "preview-arm64": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://faithfellows.com/api",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_GOOGLE_SIGNIN": "1"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
